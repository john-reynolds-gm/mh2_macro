# Python
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/

# Virtual environment
.venv/
venv/

# Build artifacts. `rm -rf data/build && rebuild.py` regenerates everything
# here EXCEPT mh2_seq.db, which is authored review state (rev 9 R2) and
# cannot be regenerated -- so it is tracked, and the glob is `data/build/*`
# rather than `data/build/` because git cannot re-include a file whose
# parent directory is excluded.
data/build/*
!data/build/mh2_seq.db

# OS junk
.DS_Store

# Editor/IDE
.vscode/
.idea/

# Word lock files left in data/source/ladders
data/source/**/~$*.docx

# Excel lock files left in data/sources/workbooks/
data/sources/workbooks/**/~$*.xlsx

# Env/secrets
.env

# Generated render — 1.8MB, rebuilt by scripts/render_static.py every run
data/reports/coverage.html

# Script output, regenerable
gap_overlap_by_state.csv

# Test for a feature of the app that has been canceled
tests/gap_overlap_by_state.py

# Read by tests/gap_overlap_by_state.py, but no longer needed for actual app build
data/source/standards/all_states_debug.csv

